# Application
APP_NAME=Football Edge Agent Backend
APP_ENV=development
APP_VERSION=0.2.0
TIMEZONE=Europe/Oslo
API_BASE_URL=http://localhost:8000
PUBLIC_BACKEND_DOMAIN=api.your-domain.no
PUBLIC_BACKEND_URL=https://api.your-domain.no
DOMAIN_REGISTRAR=domeneshop.no

# Security
INTERNAL_API_KEY=replace_with_secure_internal_key
GPT_ACTION_API_KEY=replace_with_future_gpt_action_key

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=football_edge
POSTGRES_USER=football_edge_user
POSTGRES_PASSWORD=replace_with_password
DATABASE_URL=postgresql://football_edge_user:replace_with_password@db:5432/football_edge

# Auto-betting hard lock
AUTO_BETTING_ENABLED=false
AUTO_BETTING_HARD_LOCK=true
AUTO_BETTING_PROVIDER=none
AUTO_BETTING_DRY_RUN=true
AUTO_BETTING_REQUIRE_LEGAL_REVIEW=true
AUTO_BETTING_REQUIRE_COMPLIANCE_REVIEW=true
AUTO_BETTING_REQUIRE_RISK_REVIEW=true

# Providers
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_ENABLED=false
API_FOOTBALL_KEY=replace_with_api_key
ODDS_API_BASE_URL=https://api.the-odds-api.com
ODDS_API_KEY=replace_with_api_key
SPORTSDATA_IO_BASE_URL=https://api.sportsdata.io/v4/soccer
SPORTSDATA_IO_KEY=replace_with_api_key
SOCCERDATA_API_BASE_URL=https://api.soccerdataapi.com
SOCCERDATA_API_KEY=replace_with_api_key
SPORTS_GAME_ODDS_BASE_URL=https://api.sportsgameodds.com/v2
SPORTS_GAME_ODDS_KEY=replace_with_api_key
SHARPAPI_BASE_URL=https://api.sharpapi.io/api/v1
SHARPAPI_KEY=replace_with_api_key
STATSBOMB_BASE_URL=replace_if_available
STATSBOMB_KEY=replace_if_available

# Data freshness thresholds
MAX_ODDS_AGE_MINUTES=30
MAX_FIXTURE_AGE_HOURS=24
MAX_INJURY_AGE_HOURS=24
MAX_XG_AGE_DAYS=7
MAX_TEAM_STATS_AGE_DAYS=7
LINEUP_RECHECK_WINDOW_MINUTES=90

# Approved scope
SUPPORTED_COMPETITIONS=EPL,LALIGA,BUNDESLIGA,SERIE_A,LIGUE_1,UCL,UEL,NOR_ELITESERIEN
SUPPORTED_MARKETS=1X2,OVER_UNDER_2_5,BTTS

# Logging
LOG_LEVEL=INFO
